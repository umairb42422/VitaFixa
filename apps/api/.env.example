# Copy to .env (never commit .env). Use development/test credentials only.
# Production credentials must never be used locally (TECHNICAL-ARCHITECTURE.md, section 12).
# Never place the Supabase service-role key in frontend code.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# HTTP port for the API (defaults to 3000)
PORT=3000

# Supabase project URL (public, not a secret). Required: the API refuses to start without it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
